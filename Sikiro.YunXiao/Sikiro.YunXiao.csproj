<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sikiro.YunXiao</RootNamespace>
    <Description>阿里云云效（Yunxiao / Projex）OpenAPI 封装：工作项（Bug/需求/任务）、项目、成员等</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 方案一：阿里云 V2.0 通用 SDK（AK 自签名 ROA 泛化调用） -->
    <PackageReference Include="AlibabaCloud.OpenApiClient" Version="0.2.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
